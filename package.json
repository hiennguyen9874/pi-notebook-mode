{
  "name": "@howaboua/pi-notebook-mode",
  "version": "0.1.0",
  "description": "Standalone Code and Notebook execution modes for Pi",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "pi": { "extensions": ["./dist/index.js"] },
  "files": ["dist", "code-mode/vendor/code-mode-src/LICENSE", "code-mode/vendor/code-mode-src/NOTICE", "code-mode/vendor/code-mode-src/UPSTREAM", "README.md", "PORTING_SYNC.md", "LICENSE"],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "build:code-mode-host": "cargo build --release --manifest-path code-mode/vendor/code-mode-src/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "@earendil-works/pi-tui": ">=0.84.3",
    "typebox": "*"
  },
  "dependencies": { "smol-toml": "^1.8.0", "ws": "^8.21.3", "undici": "^8.10.2", "proxy-from-env": "^2.1.0" },
  "devDependencies": { "@earendil-works/pi-ai": "0.87.0", "@earendil-works/pi-coding-agent": "0.87.0", "@earendil-works/pi-tui": "0.87.0", "@types/ws": "^8.18.1", "tsx": "^4.23.13", "typebox": "1.3.29", "typescript": "^7.0.2" },
  "engines": { "node": ">=22.19.0" }
}
